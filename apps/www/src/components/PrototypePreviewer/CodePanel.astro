---
import SiteCopyBootstrap from '../SiteCopyBootstrap.astro';
import { resolveSiteLibraryFamily, siteControlTags } from '../site-library-family';
const siteFamily = resolveSiteLibraryFamily(Astro.url.pathname);
const { Button } = siteControlTags(siteFamily);
import { highlightCode, type CodeLang } from './code-highlight';

export type { CodeLang } from './code-highlight';

interface Props {
  code: string | undefined;
  lang?: CodeLang;
  id?: string;
  labelledBy?: string;
  hidden?: boolean;
  fileIndex?: number;
  framed?: boolean;
  /** Required instructions stay readable, including before hydration. */
  collapsible?: boolean;
  copyLabel?: string;
  title?: string;
  panelRole?: 'tabpanel' | 'region';
}

const { code, lang = 'tsx', id, labelledBy, hidden, fileIndex, framed = true, collapsible = true, copyLabel = 'Copy code', title, panelRole = 'tabpanel' } = Astro.props;
const highlighted = await highlightCode(code, lang);
---

<SiteCopyBootstrap />
<figure
  id={id}
  class="relative min-w-0 max-w-full"
  role={labelledBy ? panelRole : undefined}
  aria-labelledby={labelledBy}
  hidden={hidden}
  data-code-file-panel={labelledBy ? '' : undefined}
  data-code-file-index={fileIndex}
  data-code-shell
  data-code-collapsible={String(collapsible)}
  data-code-expanded={collapsible ? undefined : 'true'}
  data-site-code-surface={framed ? 'frame' : undefined}
>
  {title && <figcaption class="code-panel__title" data-code-file-title>{title}</figcaption>}
  <div class="group relative min-w-0 max-w-full min-h-12" data-code-inner data-code-expanded={collapsible ? undefined : 'true'}>
    <div class="site-code-copy-overlay" hidden={collapsible} data-copy data-site-copy data-copy-label={copyLabel}>
    </div>

    <div class="min-w-0 max-w-full" data-code-content set:html={highlighted} />

    {collapsible && <Button
      data-site-button
      data-site-control-family={siteFamily}
      data-variant="outline"
      data-size="sm"
      class="absolute left-1/2 bottom-1/2 -translate-x-1/2 translate-y-1/2 z-10"
      data-code-toggle
      aria-expanded="false"
      aria-label="展开代码"
    >
      View code
    </Button>}
  </div>
</figure>

<script>
  import { initSiteControls } from '../site-shadcn-controls';
  import { initCodePanels } from './code-panel-client';

  initSiteControls(document);
  initCodePanels(document);
  document.addEventListener('astro:page-load', () => {
    initSiteControls(document);
    initCodePanels(document);
  });
</script>

<style is:global>
  .code-panel__title { display: flex; align-items: center; min-height: 3rem; padding: 0.5rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.875rem; overflow-wrap: anywhere; }
  /* Required source reserves a real column for Copy, outside the scroll viewport. */
  [data-code-collapsible='false'] [data-code-inner] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 0.5rem;
  }
  [data-code-collapsible='false'] [data-code-content] { grid-column: 1; grid-row: 1; }
  [data-code-collapsible='false'] .site-code-copy-overlay {
    position: static; grid-column: 2; grid-row: 1; margin: 0;
  }
  [data-code-collapsible='false'] .proto-previewer__code {
    max-height: none; padding-inline-end: 0;
  }
</style>
