---
interface Props {
  id?: string;
  class?: string;
}
const locale = Astro.locals.starlightRoute.locale === 'en' ? 'en' : 'zh-cn';
const { id = 'home-demo-previewer', class: className = '' } = Astro.props;
const copy =
  locale === 'en'
    ? {
        title: 'Workspace settings',
        family: 'Page style',
        loading: 'Preparing',
        ready: 'Ready',
        error: 'Error',
      }
    : { title: '工作区设置', family: '页面风格', loading: '准备中', ready: '就绪', error: '错误' };
const projectionOwner = `${id}-projection-${Math.random().toString(36).slice(2)}`;
---

<section
  id={id}
  class:list={['home-demo-previewer', className]}
  aria-label={copy.title}
  data-home-showcase="website-workspace-settings"
  data-locale={locale}
  data-projection-owner={projectionOwner}
  data-family-label={copy.family}
  data-runner-state="loading"
  data-runner-runtime="wc"
  data-status-loading={copy.loading}
  data-status-ready={copy.ready}
  data-status-error={copy.error}
>
  <div class="home-demo-previewer__host" data-home-demo-host aria-busy="true"></div>
  <output class="home-demo-previewer__status" data-home-demo-status aria-live="polite">
    {copy.loading}
  </output>
</section>

<style>
  /* App-owned layout and type only. Interactive surfaces belong to the selected PUI library. */
  .home-demo-previewer {
    width: min(100%, 78rem);
    margin: 0 auto;
    padding: 0 0 3rem;
    scroll-margin-block: 8rem;
    font-family: var(--font-sans);
  }
  .home-demo-previewer__host {
    position: relative;
    min-height: 20rem;
    width: 100%;
  }
  .home-demo-previewer :global(.pui-projection-generation),
  .home-demo-previewer :global(.pui-projection-scope),
  .home-demo-previewer :global(.pui-projection-content) {
    width: 100%;
    min-width: 0;
  }
  .home-demo-previewer :global(.pui-projection-controls:empty) {
    display: none;
  }
  .home-demo-previewer__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .home-demo-previewer[data-runner-state='error'] .home-demo-previewer__status,
  .home-demo-previewer[data-runner-state='loading'] .home-demo-previewer__status {
    position: static;
    display: block;
    width: auto;
    height: auto;
    margin: 0.75rem 0 0;
    clip: auto;
    white-space: normal;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .home-demo-previewer :global(.home-settings) {
    display: grid;
    gap: 1.5rem;
  }
  .home-demo-previewer :global(.home-settings__title) {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .home-demo-previewer :global(.home-settings__fields) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .home-demo-previewer :global(.home-settings__preferences) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__field) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-settings__label) {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .home-demo-previewer :global(.home-settings__switch-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-settings__muted) {
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: right;
  }
  .home-demo-previewer :global(.home-settings__footer) {
    display: grid;
    gap: 0.875rem;
  }
  .home-demo-previewer :global(.home-settings__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-settings__feedback) {
    min-height: 1.5em;
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .home-demo-previewer :global(.home-settings__layout) {
    display: grid;
    grid-template-columns: minmax(19rem, 0.8fr) minmax(0, 1.4fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .home-demo-previewer :global(.home-settings__editor) {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-preview) {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.home-preview__heading) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .home-demo-previewer :global(.home-preview__title) {
    font-size: 1.125rem;
    font-weight: 600;
  }
  .home-demo-previewer :global(.home-preview__context),
  .home-demo-previewer :global(.home-preview__view-label),
  .home-demo-previewer :global(.home-preview__detail),
  .home-demo-previewer :global(.home-preview__task-status) {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
  .home-demo-previewer :global(.home-preview__tasks) {
    display: grid;
    gap: 0.875rem;
  }
  .home-demo-previewer :global(.home-preview__surface) {
    min-width: 0;
  }
  .home-demo-previewer :global(.home-preview__surface[hidden]) {
    display: none;
  }
  .home-demo-previewer :global(.home-preview__task) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.375rem 1rem;
  }
  .home-demo-previewer :global(.home-preview__day) {
    display: none;
  }
  .home-demo-previewer :global(.home-preview__task-title) {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .home-demo-previewer :global(.home-preview__task-copy) {
    display: grid;
    gap: 0.375rem;
  }
  .home-demo-previewer :global(.home-preview__note) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
  }
  .home-demo-previewer :global(.home-preview__tasks[data-view='board']),
  .home-demo-previewer :global(.home-preview__tasks[data-view='calendar']) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
  }
  .home-demo-previewer :global(.home-preview__tasks[data-view='board'] .home-preview__task),
  .home-demo-previewer :global(.home-preview__tasks[data-view='calendar'] .home-preview__task) {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  .home-demo-previewer :global(.home-preview__tasks[data-view='calendar'] .home-preview__day) {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
  }
  @media (max-width: 767px) {
    .home-demo-previewer :global(.home-settings__layout) {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .home-demo-previewer :global(.home-settings__title) {
      font-size: 1.375rem;
      line-height: 1.3;
    }
    .home-demo-previewer :global(.home-preview__tasks[data-view='board']),
    .home-demo-previewer :global(.home-preview__tasks[data-view='calendar']) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
