---
import type { RuntimeId } from './runtimes/registry';

type DemoOption = {
  id: string;
  label: string;
  description?: string;
};

type RuntimeOption = {
  id: RuntimeId;
  label: string;
};

type BrowserRunnerResearchOption = {
  id: 'flutter-wasm' | 'qt-wasm' | 'gpui-wasm';
  label: string;
};

interface Props {
  demos: DemoOption[];
  initialDemoId?: string;
  initialRuntime?: RuntimeId;
  runtimes?: RuntimeOption[];
  browserRunnerResearch?: BrowserRunnerResearchOption[];
  id?: string;
  class?: string;
  pickerLabel?: string;
  runtimeLabel?: string;
  familyLabel?: string;
}

const locale = Astro.locals.starlightRoute.locale;
const copy =
  locale === 'en'
    ? {
        eyebrow: 'Built with Proto UI',
        title: 'Same definition. A different framework.',
        lead: 'Use the page runtime selector, then try the components below.',
        loading: 'Preparing',
        ready: 'Ready',
        error: 'Error',
        researchTitle: 'Beyond the browser',
        researchLead:
          'Flutter, Qt and GPUI browser runners are research directions, not available adapters or conformance claims.',
      }
    : {
        eyebrow: '用 Proto UI 构建',
        title: '同一份定义，换个框架试试',
        lead: '切换页面 Runtime，再试试下面的组件。',
        loading: '准备中',
        ready: '就绪',
        error: '错误',
        researchTitle: '浏览器之外',
        researchLead:
          'Flutter、Qt 和 GPUI 浏览器 runner 仍是研究方向，不代表可用 Adapter 或一致性支持。',
      };

const {
  demos,
  initialDemoId,
  initialRuntime = 'wc',
  runtimes = [
    { id: 'wc', label: 'Web Components' },
    { id: 'react', label: 'React' },
    { id: 'vue', label: 'Vue' },
    { id: 'vue2', label: 'Vue 2' },
  ],
  browserRunnerResearch = [
    { id: 'flutter-wasm', label: 'Flutter' },
    { id: 'qt-wasm', label: 'Qt' },
    { id: 'gpui-wasm', label: 'GPUI' },
  ],
  id = 'home-demo-previewer',
  class: className = '',
  pickerLabel = 'Component',
  runtimeLabel = 'Runtime',
  familyLabel = locale === 'en' ? 'Page style' : '页面风格',
} = Astro.props;

if (!Array.isArray(demos) || demos.length === 0) {
  throw new Error('[HomeDemoPreviewer] "demos" must include at least one demo option.');
}

const initialDemo = demos.find((demo) => demo.id === initialDemoId) ?? demos[0];
const researchOptions = browserRunnerResearch.map((option) => ({
  ...option,
  status: 'research' as const,
}));
const initialRuntimeLabel =
  runtimes.find((runtime) => runtime.id === initialRuntime)?.label ?? initialRuntime;
const instanceToken = Math.random().toString(36).slice(2);
const projectionOwner = `${id}-projection-${instanceToken}`;
---

<section
  id={id}
  class:list={['home-demo-previewer', className]}
  data-home-demo-options={JSON.stringify(demos)}
  data-runtime-options={JSON.stringify(runtimes)}
  data-browser-runner-research={JSON.stringify(researchOptions)}
  data-initial-demo-id={initialDemo.id}
  data-initial-runtime={initialRuntime}
  data-projection-owner={projectionOwner}
  data-picker-label={pickerLabel}
  data-runtime-label={runtimeLabel}
  data-family-label={familyLabel}
  data-runner-state="loading"
  data-runner-runtime={initialRuntime}
  data-status-loading={copy.loading}
  data-status-ready={copy.ready}
  data-status-error={copy.error}
>
  <div class="home-demo-previewer__panel pui-runtime-box">
    <div class="home-demo-previewer__header">
      <div class="home-demo-previewer__intro">
        <p class="home-demo-previewer__intro-eyebrow">{copy.eyebrow}</p>
        <h2 class="home-demo-previewer__intro-title">{copy.title}</h2>
        <p class="home-demo-previewer__description" data-home-demo-description>
          {initialDemo.description ?? copy.lead}
        </p>
      </div>
      <output class="home-demo-previewer__status" data-home-demo-status aria-live="polite">
        {initialRuntimeLabel} · {copy.loading}
      </output>
    </div>

    <div class="home-demo-previewer__definition">
      <span>{locale === 'en' ? 'Shared definition' : '共享定义'}</span>
      <a
        data-home-demo-source
        href={`https://github.com/Proto-UI/Proto-UI/blob/main/apps/www/src/content/docs/zh-cn/${initialDemo.id}.demo.ts`}
      >
        {initialDemo.id}.demo.ts
      </a>
      <span class="home-demo-previewer__definition-arrow" aria-hidden="true">→</span>
      <span>{locale === 'en' ? 'Live component below' : '下方真实渲染'}</span>
    </div>

    <div class="home-demo-previewer__host" data-home-demo-host aria-busy="true"></div>
  </div>
  <p class="home-demo-previewer__scope">
    {
      locale === 'en'
        ? 'Page runtime switches navigation, theme, language, actions and this example. Astro keeps the static content; search remains a docs service. Switching resets example state.'
        : '页面 Runtime 切换导航、主题、语言、操作与本例中的 Proto UI 实现。Astro 保留静态内容，搜索由文档服务提供；切换会重置示例状态。'
    }
  </p>
  <div class="home-demo-previewer__research">
    <div class="home-demo-previewer__research-copy">
      <p class="home-demo-previewer__research-title">{copy.researchTitle}</p>
      <p class="home-demo-previewer__research-lead">{copy.researchLead}</p>
    </div>
    <ul class="home-demo-previewer__research-targets" aria-label={copy.researchTitle}>
      {
        researchOptions.map((option) => (
          <li data-browser-runner-research-id={option.id}>{option.label}</li>
        ))
      }
    </ul>
  </div>

  <script>
    import { initHomeDemoPreviewer } from './home-demo-client';

    function init() {
      document
        .querySelectorAll<HTMLElement>(
          '.home-demo-previewer[data-home-demo-options]:not([data-inited])'
        )
        .forEach((root) => initHomeDemoPreviewer(root));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</section>

<style>
  .home-demo-previewer {
    width: min(100%, 68rem);
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
    scroll-margin-block: 5rem;
    font-family: var(--font-sans);
  }

  .home-demo-previewer__panel {
    overflow: hidden;
    color: var(--color-card-foreground);
    background: var(--color-card);
    border: var(--runtime-box-border);
    border-radius: var(--runtime-box-radius);
  }

  .home-demo-previewer__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem 1.5rem 1rem;
  }

  .home-demo-previewer__intro {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .home-demo-previewer__intro-eyebrow,
  .home-demo-previewer__intro-title,
  .home-demo-previewer__description {
    margin: 0;
  }
  .home-demo-previewer__intro-eyebrow {
    display: none;
  }
  .home-demo-previewer__intro-title {
    color: var(--color-foreground);
    font-size: 1.125rem;
    font-weight: 550;
    line-height: 1.5;
    letter-spacing: -0.015em;
  }
  .home-demo-previewer__description {
    max-width: 46rem;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .home-demo-previewer__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .home-demo-previewer__status::before {
    width: 0.375rem;
    height: 0.375rem;
    content: '';
    background: var(--color-muted-foreground);
    border-radius: 50%;
  }
  .home-demo-previewer[data-runner-state='ready'] .home-demo-previewer__status::before {
    background: var(--color-primary);
  }
  .home-demo-previewer[data-runner-state='error'] .home-demo-previewer__status::before {
    background: var(--color-destructive);
  }
  .home-demo-previewer__definition {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding: 0.75rem 1.5rem;
    color: var(--color-muted-foreground);
    background: color-mix(in oklch, var(--color-muted) 28%, var(--color-card));
    border-block: 1px solid var(--color-border);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .home-demo-previewer__definition a {
    color: var(--color-foreground);
    font-family: var(--font-mono, monospace);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .home-demo-previewer__host {
    position: relative;
    min-height: 15rem;
    width: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .home-demo-previewer :global(.pui-projection-generation) {
    width: 100%;
  }
  .home-demo-previewer :global(.pui-projection-scope) {
    display: grid;
    width: 100%;
  }
  .home-demo-previewer :global(.pui-projection-controls) {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, auto);
    justify-content: start;
    gap: 0.875rem;
    padding: var(--runtime-box-toolbar-padding);
    background: var(--color-card);
  }
  .home-demo-previewer :global(.pui-projection-control) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    min-width: 0;
  }
  .home-demo-previewer :global(.pui-projection-control-label) {
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1rem;
  }
  .home-demo-previewer :global(.pui-projection-content) {
    min-height: var(--runtime-box-content-min);
    min-width: 0;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--runtime-box-content-padding);
    overflow: hidden;
    background: var(--runtime-box-canvas);
    border-top: 1px solid var(--color-border);
  }
  .home-demo-previewer__scope {
    max-width: 58rem;
    margin: 0.875rem 0 0;
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    line-height: 1.75;
  }
  .home-demo-previewer__research {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .home-demo-previewer__research-copy {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .home-demo-previewer__research-title,
  .home-demo-previewer__research-lead {
    margin: 0;
  }
  .home-demo-previewer__research-title {
    color: var(--color-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .home-demo-previewer__research-lead {
    margin-top: 0.25rem;
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    line-height: 1.7;
  }
  .home-demo-previewer__research-targets {
    display: flex;
    gap: 1rem;
    padding: 0;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: 0.75rem;
    list-style: none;
  }
  @media (max-width: 720px) {
    .home-demo-previewer {
      padding-inline: 1rem;
    }
    .home-demo-previewer__header {
      grid-template-columns: 1fr;
      gap: 0.625rem;
      padding: 1rem;
    }
    .home-demo-previewer__definition {
      padding-inline: 1rem;
    }
    .home-demo-previewer :global(.pui-projection-controls) {
      grid-template-columns: 1fr;
      padding: 1rem;
    }
    .home-demo-previewer :global(.pui-projection-content) {
      min-height: var(--runtime-box-content-min);
      padding: 1.5rem 1rem;
    }
    .home-demo-previewer__research {
      margin-top: 1.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-demo-previewer {
      scroll-behavior: auto;
    }
  }
</style>
