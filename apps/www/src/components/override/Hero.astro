---
import HomeActions from '../Homepage/HomeActions.astro';
import { PAGE_TITLE_ID } from '../../constants';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const locale = Astro.locals.starlightRoute.locale;
const whitepaperHref =
  locale && locale !== 'root' ? `/${locale}/whitepaper/0-preface/` : '/whitepaper/0-preface/';
const whitepaperLabel =
  locale === 'zh-cn'
    ? '我们还要发明多少次 Button？ →'
    : 'How many more times must we reinvent the Button? →';
---

<section class="homepage-hero" aria-labelledby={PAGE_TITLE_ID}>
  <HomeActions
    id="homepage-whitepaper"
    class="homepage-hero__eyebrow"
    actions={[{ text: whitepaperLabel, link: whitepaperHref, variant: 'minimal' }]}
  />
  <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
  {tagline && <p class="homepage-hero__tagline" set:html={tagline} />}
  {
    actions.length > 0 && (
      <HomeActions id="homepage-hero-actions" class="homepage-hero__actions" actions={actions} />
    )
  }
</section>

<style>
  .homepage-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(2.75rem, 6vw, 5rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .homepage-hero :global(.homepage-hero__eyebrow) {
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }

  .homepage-hero h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-foreground);
    font-size: clamp(2rem, 4.3vw, 3.25rem);
    font-weight: 560;
    line-height: 1.16;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .homepage-hero h1:lang(zh) {
    max-width: 100%;
    letter-spacing: -0.025em;
  }

  .homepage-hero__tagline {
    max-width: 39rem;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: clamp(0.9375rem, 1.6vw, 1.125rem);
    font-weight: 400;
    line-height: 1.75;
    text-wrap: balance;
  }

  .homepage-hero :global(.homepage-hero__actions) {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    padding-top: 0.25rem;
  }

  @media (max-width: 480px) {
    .homepage-hero {
      gap: 1rem;
      padding-inline: 1rem;
    }
    .homepage-hero h1 {
      max-width: 13ch;
    }
  }
</style>
