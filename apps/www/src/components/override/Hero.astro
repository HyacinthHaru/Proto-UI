---
import HomeActions from '../Homepage/HomeActions.astro';
import { PAGE_TITLE_ID } from '../../constants';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const locale = Astro.locals.starlightRoute.locale;
const whitepaperHref =
  locale && locale !== 'root' ? `/${locale}/whitepaper/0-preface/` : '/whitepaper/0-preface/';
const whitepaperLabel =
  locale === 'zh-cn'
    ? '我们还要发明多少次 Button？ →'
    : 'How many more times must we reinvent the Button? →';
---

<section class="homepage-hero" aria-labelledby={PAGE_TITLE_ID}>
  <HomeActions
    id="homepage-whitepaper"
    class="homepage-hero__eyebrow"
    actions={[{ text: whitepaperLabel, link: whitepaperHref, variant: 'minimal' }]}
  />
  <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
  {tagline && <p class="homepage-hero__tagline" set:html={tagline} />}
  {
    actions.length > 0 && (
      <HomeActions id="homepage-hero-actions" class="homepage-hero__actions" actions={actions} />
    )
  }
</section>

<style>
  .homepage-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 54rem;
    margin-inline: auto;
    padding: 1.5rem 0 0;
    text-align: center;
  }
  .homepage-hero :global(.homepage-hero__eyebrow) {
    margin-bottom: 1rem;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .homepage-hero :global(.homepage-hero__eyebrow .home-runtime-anchor),
  .homepage-hero :global(.homepage-hero__eyebrow .home-actions-fallback a) {
    padding: 0;
    min-height: 1.5rem;
    white-space: normal;
    line-height: 1.5;
    text-wrap: balance;
  }
  .homepage-hero h1 {
    max-width: 100%;
    margin: 0;
    color: var(--color-foreground);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 650;
    line-height: 1.17;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .homepage-hero h1:lang(zh) {
    max-width: 18em;
    letter-spacing: -0.02em;
  }
  .homepage-hero__tagline {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--color-muted-foreground);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    text-wrap: balance;
  }
  .homepage-hero :global(.homepage-hero__actions) {
    width: 100%;
    margin-top: 1.5rem;
  }
  .homepage-hero :global(.homepage-hero__actions .home-runtime-actions),
  .homepage-hero :global(.homepage-hero__actions .home-actions-fallback) {
    justify-content: center;
    gap: 0.75rem;
  }
  .homepage-hero :global(.homepage-hero__actions .home-runtime-anchor),
  .homepage-hero :global(.homepage-hero__actions .home-actions-fallback a) {
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  @media (max-width: 767px) {
    .homepage-hero {
      padding-top: 0;
    }
    .homepage-hero h1 {
      font-size: clamp(1.625rem, 7.4vw, 1.875rem);
      line-height: 1.18;
      text-wrap: pretty;
    }
    .homepage-hero__tagline {
      font-size: 1rem;
      line-height: 1.625;
    }
  }
</style>
