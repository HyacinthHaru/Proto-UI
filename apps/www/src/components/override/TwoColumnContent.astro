---
const { hasSidebar, entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const mainPaneClass = isSplash
  ? 'main-pane mx-auto flex w-full max-w-[88rem] min-w-0 flex-1 flex-col gap-8 px-1 py-6 text-foreground md:px-6 lg:gap-10 lg:py-10'
  : 'main-pane mx-auto flex w-full max-w-2xl min-w-0 flex-1 flex-col gap-8 px-5 py-6 text-neutral-800 md:px-0 lg:py-8 dark:text-neutral-200';
---

<div class="docs-reading-columns lg:sl-flex">
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
  <div
    class={mainPaneClass}
    data-layout={isSplash ? 'splash' : 'docs'}
    data-has-sidebar={hasSidebar}
  >
    <slot />
  </div>
</div>

<style>
  @layer starlight.core {
    .main-pane {
      isolation: isolate;
    }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: calc(
          var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
        );
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        width: 100%;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto 0;

        order: 1;
        width: calc(
          var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
        );
      }

      .main-pane[data-layout='splash'] {
        width: 100%;
        max-width: min(100%, 88rem);
      }
    }
  }
</style>

<style>
  /* Viewport media queries use the initial font size. The actual reading canvas
     must also respond to enlarged root text, before the old column arithmetic
     compresses the TOC into individual letters. Keep the same native TOC in
     normal flow; no hidden duplicate or new disclosure owner is needed. */
  @media (min-width: 64rem) {
    @container docs-canvas (max-width: 80rem) {
      .docs-reading-columns {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .right-sidebar-container {
        display: flex;
        position: static;
        order: 0;
        width: 100%;
        height: auto;
        padding-bottom: 0;
        overflow: visible;
      }
      .right-sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding-block: 0;
        overflow: visible;
      }
      :global([data-has-sidebar][data-has-toc]) .main-pane {
        order: 1;
        width: 100%;
      }
    }
  }
</style>
