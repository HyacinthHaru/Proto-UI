---
export interface HomeAction {
  text: string;
  link: string;
  variant?: 'primary' | 'secondary' | 'minimal' | 'link';
  attrs?: Record<string, unknown>;
  icon?: unknown;
}
interface Props {
  id: string;
  actions: HomeAction[];
  class?: string;
  runtimeControl?: boolean;
  themeButton?: boolean;
  themeIcon?: boolean;
  menuButton?: boolean;
}
const {
  id,
  actions,
  class: className,
  runtimeControl = false,
  themeButton = false,
  themeIcon = false,
  menuButton = false,
} = Astro.props;
const locale = Astro.locals.starlightRoute.locale;
const themeLabel = locale === 'zh-cn' ? '切换主题' : 'Toggle theme';
const menuLabel = locale === 'zh-cn' ? '导航与设置' : 'Navigation and settings';
---

<div
  id={id}
  class:list={['home-actions', className]}
  data-homepage-actions
  data-homepage-controls={runtimeControl ? 'runtime' : undefined}
  data-homepage-theme-label={themeLabel}
  data-homepage-theme-icon={themeIcon ? 'true' : undefined}
  data-homepage-menu-label={menuButton ? menuLabel : undefined}
>
  <div class="home-actions-fallback" data-homepage-fallback>
    {
      actions.map(({ text, link, variant = 'primary', attrs = {} }) => (
        <a {...attrs} href={link} data-home-action-variant={variant}>
          {text}
        </a>
      ))
    }
    {
      themeButton && (
        <button type="button" data-homepage-theme aria-label={themeLabel}>
          {themeIcon ? <span class="site-header-theme-icon" aria-hidden="true" /> : themeLabel}
        </button>
      )
    }
    {
      menuButton && (
        <span data-homepage-menu hidden>
          {menuLabel}
        </span>
      )
    }
    {runtimeControl && <span class="site-header-runtime-placeholder">Web Components</span>}
  </div>
  <div data-homepage-mount></div>
</div>

<style is:global>
  .home-actions {
    min-width: 0;
    position: relative;
  }
  .home-actions-fallback,
  .home-runtime-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  .home-actions [data-homepage-fallback][hidden] {
    display: none;
  }
  .home-actions-fallback a,
  .home-runtime-anchor {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.65rem;
    padding: 0.6rem 1rem;
    border-radius: inherit;
    color: inherit;
    font: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .home-actions-fallback a {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
  }
  .home-actions-fallback a[data-home-action-variant='primary'] {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    border-color: transparent;
  }
  .home-actions-fallback a[data-home-action-variant='minimal'],
  .home-actions-fallback a[data-home-action-variant='link'] {
    border-color: transparent;
  }
  .home-runtime-anchor {
    border: 1px solid var(--pui-border);
    border-radius: var(--pui-radius-lg, 0.5rem);
    background: var(--pui-background);
    color: var(--pui-foreground);
  }
  .home-runtime-anchor[data-home-link-recipe='primary'] {
    background: var(--pui-primary);
    color: var(--pui-primary-foreground);
    border-color: transparent;
  }
  .home-runtime-anchor[data-home-link-recipe='minimal'],
  .home-runtime-anchor[data-home-link-recipe='link'] {
    background: transparent;
    border-color: transparent;
  }
  .home-runtime-anchor[data-home-link-recipe='link'] {
    color: var(--pui-primary);
  }
  .home-runtime-anchor[data-projection-family='brutalist'] {
    border-width: 2px;
    border-radius: 0;
    font-weight: 700;
    text-transform: uppercase;
  }
  .home-runtime-anchor[data-projection-family='brutalist'][data-home-link-recipe='primary'],
  .home-runtime-anchor[data-projection-family='brutalist'][data-home-link-recipe='secondary'] {
    border-color: var(--pui-border);
    box-shadow: 4px 4px 0 var(--pui-border);
  }
  .home-runtime-anchor:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 3px;
  }
  .home-runtime-anchor:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-theme-accessible-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .home-actions .pui-projection-controls:empty {
    display: none;
  }
  .home-actions .pui-projection-content {
    min-width: 0;
  }
  .home-actions [data-homepage-mount] {
    min-width: 0;
    position: relative;
  }
  .home-actions .pui-projection-generation {
    min-width: 0;
  }
</style>
