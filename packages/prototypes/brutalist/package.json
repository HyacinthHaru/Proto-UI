{
  "name": "@proto.ui/prototypes-brutalist",
  "version": "0.2.0-rc.3",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "@proto.ui/prototypes-base": "workspace:*"
  },
  "devDependencies": {
    "@proto.ui/module-as-trigger": "workspace:*",
    "@proto.ui/module-event": "workspace:*",
    "@proto.ui/module-rule-meta": "workspace:*",
    "@proto.ui/runtime": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button/index.ts",
      "default": "./src/button/index.ts"
    },
    "./toggle": {
      "types": "./src/toggle/index.ts",
      "default": "./src/toggle/index.ts"
    },
    "./switch": {
      "types": "./src/switch/index.ts",
      "default": "./src/switch/index.ts"
    },
    "./tabs": {
      "types": "./src/tabs/index.ts",
      "default": "./src/tabs/index.ts"
    }
  },
  "description": "Neo-Brutalist Proto UI prototype library for adapter-driven components.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/prototypes/brutalist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/prototypes/brutalist"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "prototypes",
    "brutalist",
    "neo-brutalist",
    "prototype-library"
  ]
}
