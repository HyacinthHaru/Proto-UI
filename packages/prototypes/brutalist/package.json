{
  "name": "@proto.ui/prototypes-brutalist",
  "version": "0.2.0-rc.6",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "@proto.ui/prototypes-base": "workspace:*"
  },
  "devDependencies": {
    "@proto.ui/module-as-trigger": "workspace:*",
    "@proto.ui/module-event": "workspace:*",
    "@proto.ui/module-rule-meta": "workspace:*",
    "@proto.ui/runtime": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    }
  },
  "description": "Neo-Brutalist Proto UI prototype library foundation and reference Button projection.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/prototypes/brutalist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/prototypes/brutalist"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "prototype-library",
    "brutalist",
    "neo-brutalist"
  ],
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build/public-packages.mjs --package @proto.ui/prototypes-brutalist",
    "prepack": "pnpm run build"
  }
}
