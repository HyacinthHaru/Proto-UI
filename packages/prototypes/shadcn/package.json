{
  "name": "@proto.ui/prototypes-shadcn",
  "version": "0.2.0-rc.5",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "protoUi": {
    "release": {
      "thirdPartyNotices": [
        "THIRD_PARTY_NOTICES.md"
      ]
    }
  },
  "dependencies": {
    "@proto.ui/core": "workspace:*",
    "@proto.ui/prototypes-base": "workspace:*"
  },
  "devDependencies": {
    "@proto.ui/module-as-trigger": "workspace:*",
    "@proto.ui/module-event": "workspace:*",
    "@proto.ui/module-rule-meta": "workspace:*",
    "@proto.ui/runtime": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button/index.ts",
      "default": "./src/button/index.ts"
    },
    "./component-presets": {
      "types": "./src/component-presets.ts",
      "default": "./src/component-presets.ts"
    },
    "./dialog": {
      "types": "./src/dialog/index.ts",
      "default": "./src/dialog/index.ts"
    },
    "./dropdown": {
      "types": "./src/dropdown/index.ts",
      "default": "./src/dropdown/index.ts"
    },
    "./hover-card": {
      "types": "./src/hover-card/index.ts",
      "default": "./src/hover-card/index.ts"
    },
    "./select": {
      "types": "./src/select/index.ts",
      "default": "./src/select/index.ts"
    },
    "./switch": {
      "types": "./src/switch/index.ts",
      "default": "./src/switch/index.ts"
    },
    "./tabs": {
      "types": "./src/tabs/index.ts",
      "default": "./src/tabs/index.ts"
    },
    "./toggle": {
      "types": "./src/toggle/index.ts",
      "default": "./src/toggle/index.ts"
    }
  },
  "description": "shadcn-style Proto UI prototype library for adapter-driven components.",
  "license": "MIT",
  "homepage": "https://github.com/Proto-UI/Proto-UI/tree/main/packages/prototypes/shadcn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proto-UI/Proto-UI.git",
    "directory": "packages/prototypes/shadcn"
  },
  "bugs": {
    "url": "https://github.com/Proto-UI/Proto-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "proto-ui",
    "proto",
    "ui",
    "prototypes",
    "shadcn",
    "prototype-library",
    "shadcn-style"
  ]
}
