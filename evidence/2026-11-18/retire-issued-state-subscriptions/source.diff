+  it('allows an already-issued State unsubscribe during terminal notification', () => {
+    const invoke = vi.fn((call: () => void) => call());
+    const reader = createScopedExposesReader(() => invoke);
+    const cancel = vi.fn();
+    const handle = {
+      [EXPOSE_STATE_EXTERNAL_HANDLE]: true,
+      get: () => false,
+      subscribe: () => cancel,
+      unsubscribe: (off: () => void) => off(),
+      spec: { kind: 'bool' },
+    } as const;
+    const state = reader.read({ active: handle }).active as typeof handle;
+    state.subscribe()();
+    expect(cancel).toHaveBeenCalledTimes(1);
+    expect(invoke).toHaveBeenCalledTimes(2);
+    const disposeSubscription = state.subscribe();
+    reader.invalidate();
+    // The Expose State module clears remaining subscriptions at disposal.
+    // An issued cancellation must not reenter the dead callback scope.
+    expect(disposeSubscription).not.toThrow();
+    expect(cancel).toHaveBeenCalledTimes(1);
+    expect(invoke).toHaveBeenCalledTimes(3);
+    expect(() => state.get()).toThrow(/terminal disposal/);
+    expect(() => state.subscribe()).toThrow(/terminal disposal/);
+  });
